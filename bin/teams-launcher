#!/usr/bin/env bash
set -euo pipefail

TEAMS_URL="https://teams.microsoft.com/v2/"
PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/teams-launcher.pid"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Usage ────────────────────────────────────────────────────────────────────
usage() {
  cat <<'EOF'
Usage: teams-launcher [OPTIONS]

Launch Microsoft Teams as an isolated Chromium PWA.

Options:
  --mode ephemeral|persistent   Profile mode (default: ephemeral)
                                  ephemeral  - RAM profile deleted on exit
                                  persistent - profile kept across launches
  --dry-run                     Print resolved profile path and command; do not launch
  --help                        Show this help text and exit

Environment variables:
  TEAMS_MODE       Equivalent to --mode (flag takes precedence)
  CHROMIUM         Path to Chromium binary (auto-detected if unset)
  XDG_RUNTIME_DIR  Base dir for ephemeral profiles (default: /tmp)
  XDG_DATA_HOME    Base dir for persistent profile (default: ~/.local/share)

Install Chromium if missing:
  sudo apt install chromium
EOF
}

# ── Chromium detection ────────────────────────────────────────────────────────
find_chromium() {
  local candidates=()
  [[ -n "${CHROMIUM:-}" ]] && candidates+=("${CHROMIUM}")
  candidates+=("chromium" "chromium-browser")

  local candidate
  for candidate in "${candidates[@]}"; do
    if command -v "${candidate}" &>/dev/null; then
      printf '%s' "${candidate}"
      return 0
    fi
  done

  printf 'Error: no Chromium binary found.\n' >&2
  printf '\nTried in order: CHROMIUM env var, chromium, chromium-browser\n' >&2
  printf '\nInstall with:\n  sudo apt install chromium\n' >&2
  printf '\nOr: CHROMIUM=/path/to/chromium teams-launcher\n' >&2
  return 1
}

# ── Window raise (single-instance) ───────────────────────────────────────────
# Try three approaches in order: xdotool (X11/XWayland), wmctrl (X11/XWayland),
# KWin D-Bus scripting (KDE Wayland native). Silently succeeds if any works.
raise_window() {
  # X11 / XWayland — xdotool
  if command -v xdotool &>/dev/null; then
    if xdotool search --class TeamsLauncher windowactivate --sync 2>/dev/null; then
      return 0
    fi
  fi

  # X11 / XWayland — wmctrl
  if command -v wmctrl &>/dev/null; then
    if wmctrl -xa TeamsLauncher 2>/dev/null; then
      return 0
    fi
  fi

  # KDE Wayland — inject a one-shot KWin script via D-Bus
  local _qdbus=""
  if command -v qdbus6 &>/dev/null; then
    _qdbus="qdbus6"
  elif command -v qdbus &>/dev/null; then
    _qdbus="qdbus"
  fi
  if [[ -n "${_qdbus}" ]]; then
    local _script _sid
    _script="$(mktemp /tmp/teams-kwin-XXXXXX.js)" || return 0
    # KWin normalises resourceClass to lowercase; TeamsLauncher -> teamslauncher
    printf '%s' \
      'workspace.clientList().forEach(function(c){' \
      'if(c.resourceClass==="teamslauncher"){' \
      'c.minimized=false;workspace.activeClient=c;}});' \
      > "${_script}"
    _sid="$("${_qdbus}" org.kde.KWin /Scripting \
             org.kde.kwin.Scripting.loadScript "${_script}" "" 2>/dev/null)" || _sid=""
    if [[ -n "${_sid}" ]]; then
      "${_qdbus}" org.kde.KWin "/Scripting/Script${_sid}" \
        org.kde.kwin.Script.run 2>/dev/null || true
      "${_qdbus}" org.kde.KWin /Scripting \
        org.kde.kwin.Scripting.unloadScript "${_sid}" 2>/dev/null || true
    fi
    rm -f "${_script}"
  fi
  return 0
}

# ── Window property injection ─────────────────────────────────────────────────
# Polls until the Teams window appears (up to 15 s), then sets
# _KDE_NET_WM_DESKTOP_FILE so KDE associates the correct .desktop icon.
_apply_window_props() {
  local deadline wid
  deadline=$(( $(date +%s) + 15 ))
  while [[ $(date +%s) -lt ${deadline} ]]; do
    if command -v xdotool &>/dev/null; then
      wid="$(xdotool search --class TeamsLauncher 2>/dev/null | head -1 || true)"
      if [[ -n "${wid}" ]]; then
        if command -v xprop &>/dev/null; then
          xprop -id "${wid}" \
            -f _KDE_NET_WM_DESKTOP_FILE 8s \
            -set _KDE_NET_WM_DESKTOP_FILE "teams-launcher" 2>/dev/null || true
        fi
        return 0
      fi
    fi
    sleep 1
  done
}

# ── Cleanup ───────────────────────────────────────────────────────────────────
cleanup() {
  if [[ -n "${PROPS_PID}" ]]; then
    kill "${PROPS_PID}" 2>/dev/null || true
  fi
  rm -f "${PID_FILE}"
  if [[ "${CLEANUP_PROFILE}" == "true" && -n "${PROFILE:-}" && -d "${PROFILE}" ]]; then
    rm -rf "${PROFILE}"
  fi
}

# ── Signal handler ────────────────────────────────────────────────────────────
handle_signal() {
  if [[ -n "${CHROMIUM_PID}" ]]; then
    kill "${CHROMIUM_PID}" 2>/dev/null || true
  fi
  if [[ -n "${PROPS_PID}" ]]; then
    kill "${PROPS_PID}" 2>/dev/null || true
  fi
  exit 143
}

# ── Argument parsing ──────────────────────────────────────────────────────────
MODE="${TEAMS_MODE:-ephemeral}"
DRY_RUN=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help)    usage; exit 0 ;;
    --dry-run) DRY_RUN=true; shift ;;
    --mode=*)  MODE="${1#--mode=}"; shift ;;
    --mode)
      [[ $# -lt 2 ]] && { printf 'Error: --mode requires a value\n' >&2; exit 2; }
      MODE="$2"; shift 2 ;;
    -*) printf 'Error: unknown flag: %s\n' "$1" >&2; exit 2 ;;
    *)  printf 'Error: unexpected argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

if [[ "${MODE}" != "ephemeral" && "${MODE}" != "persistent" ]]; then
  printf 'Error: --mode must be "ephemeral" or "persistent", got: %s\n' "${MODE}" >&2
  exit 2
fi

# ── Single-instance check (skip for dry-run) ──────────────────────────────────
if [[ "${DRY_RUN}" == "false" && -f "${PID_FILE}" ]]; then
  _existing_pid=""
  read -r _existing_pid < "${PID_FILE}" 2>/dev/null || true
  if [[ -n "${_existing_pid}" ]] && kill -0 "${_existing_pid}" 2>/dev/null; then
    raise_window
    exit 0
  fi
  # Stale lockfile — clear it before launching
  rm -f "${PID_FILE}"
fi

# ── Chromium detection (fail fast before touching disk) ───────────────────────
CHROMIUM_BIN="$(find_chromium)"

# ── Profile setup ─────────────────────────────────────────────────────────────
CLEANUP_PROFILE=false
PROFILE=""
CHROMIUM_PID=""
PROPS_PID=""

if [[ "${MODE}" == "ephemeral" ]]; then
  CLEANUP_PROFILE=true
  PROFILE="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/teams-launcher-XXXXXXXXXX")"
else
  PROFILE="${XDG_DATA_HOME:-${HOME}/.local/share}/teams-launcher/profile"
  mkdir -p "${PROFILE}"
fi

# ── Traps (set immediately after profile exists) ──────────────────────────────
trap cleanup EXIT
trap handle_signal TERM INT

# ── Extension detection ───────────────────────────────────────────────────────
EXTENSION_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/teams-launcher/extension"
if [[ ! -d "${EXTENSION_DIR}" ]]; then
  EXTENSION_DIR="${SCRIPT_DIR}/../share/extension"
fi

# ── Build Chromium args ───────────────────────────────────────────────────────
CHROMIUM_ARGS=(
  "--user-data-dir=${PROFILE}"
  "--app=${TEAMS_URL}"
  "--class=TeamsLauncher"
  "--no-first-run"
  "--no-default-browser-check"
  "--password-store=basic"
)
if [[ -d "${EXTENSION_DIR}" ]]; then
  CHROMIUM_ARGS+=("--load-extension=${EXTENSION_DIR}")
fi

# ── Dry-run ───────────────────────────────────────────────────────────────────
if [[ "${DRY_RUN}" == "true" ]]; then
  printf 'PROFILE=%s\n' "${PROFILE}"
  printf 'COMMAND=%s' "${CHROMIUM_BIN}"
  for arg in "${CHROMIUM_ARGS[@]}"; do
    printf ' %s' "${arg}"
  done
  printf '\n'
  exit 0
fi

# ── Write PID file ────────────────────────────────────────────────────────────
printf '%d\n' "$$" > "${PID_FILE}"

# ── Launch ────────────────────────────────────────────────────────────────────
"${CHROMIUM_BIN}" "${CHROMIUM_ARGS[@]}" &
CHROMIUM_PID="$!"

_apply_window_props &
PROPS_PID="$!"

wait "${CHROMIUM_PID}"
CHROMIUM_PID=""
